# Supabase project URL and the publishable (or legacy anon) key.
# Never put the service role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Accepted when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SendPilot (server-only). Never prefix these with NEXT_PUBLIC_.
SENDPILOT_API_BASE_URL=https://api.sendpilot.ai/v1
SENDPILOT_API_KEY=
# Copied from SendPilot → Integrations → Webhooks after you create the subscription.
SENDPILOT_WEBHOOK_SECRET=

# Optional public origin used to display webhook URLs in Settings (no trailing slash).
# NEXT_PUBLIC_APP_URL=https://sales-app-theta-eight.vercel.app

# 32-byte AES-256-GCM key as 64 hex characters (or standard base64 of 32 bytes).
# Server-only. Never prefix with NEXT_PUBLIC_. Required to encrypt/decrypt per-integration credentials.
SENDPILOT_SECRETS_ENCRYPTION_KEY=

# Server-only. Required for POST /api/sendpilot/webhook writes (RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
