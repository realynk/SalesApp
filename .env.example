# Supabase project URL and the publishable (or legacy anon) key.
# Never put the service role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Accepted when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave these unset until a documented SendPilot API contract exists.
# The app will not call undocumented SendPilot endpoints.
SENDPILOT_API_BASE_URL=
SENDPILOT_API_KEY=
SENDPILOT_WEBHOOK_SECRET=
